# Copy this file to .env.local and fill in the two values from your Supabase project
# (Project Settings > API). The anon key is meant to be public: your data is protected
# by the row-level security policies in supabase/schema.sql, not by hiding this key.
# Leave both empty to run the site without accounts.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
